# Optional: the default is the official endpoint below.
CHAT_API_URL=https://api.nexray.eu.cc/ai/copilot
# Only set if the upstream provider actually requires a Bearer token.
CHAT_API_KEY=
# Server-side timeout in milliseconds, clamped to 1000–22000.
CHAT_TIMEOUT_MS=18000
# Never prefix provider credentials with VITE_.

# Ratings: paste these TWO values from one Upstash Redis database.
# No schema, migrations, dashboard admin, or SDK installation required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
