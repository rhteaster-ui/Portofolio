# Required only to enable public ratings. Paste from one Upstash Redis database.
# No schema, migrations, extra SDK, email service, or additional required env.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chat already uses the original Nexray endpoint without configuration.
# Production Vercel hostname is detected automatically for canonical, robots and sitemap.
# Optional custom-domain/provider settings are documented in README.md.
